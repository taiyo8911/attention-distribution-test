    },
    "A little practice each day steadily improves your attention skills." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日少しずつ続けることで、注意配分の力が着実に伸びます"
          }
        }
      }
    },
    "After tapping a number, press the Confirm button to proceed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数字をタップしたらその都度、下部の「確認」ボタンを押して進みます"
